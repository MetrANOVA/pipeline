PIPELINE_YAML=/app/pipelines/data_flow.yml
KAFKA_TOPIC=metranova_flow
CLICKHOUSE_FLOW_TABLE=data_flow
CLICKHOUSE_CACHER_TABLES=${CLICKHOUSE_AS_METADATA_TABLE},${CLICKHOUSE_DEVICE_METADATA_TABLE}:@loopback_ip,${CLICKHOUSE_IF_METADATA_TABLE}:device_id:flow_index:edge
CLICKHOUSE_RANGED_CACHER_CONFIGS=meta_application:${CLICKHOUSE_APPLICATION_METADATA_TABLE}_dict:port_range_min:port_range_max:protocol:id
IP_CACHER_TABLES=${CLICKHOUSE_SCIREG_METADATA_TABLE},${CLICKHOUSE_IP_METADATA_TABLE}
CLICKHOUSE_CACHER_REFRESH_INTERVAL=3600
CLICKHOUSE_FLOW_POLICY_COMMUNITY_SCOPE_MAP=64805:lhcone,64806:lsst,64807:fabric,293:ipt
CLICKHOUSE_FLOW_EXTENSIONS=bgp,ipv4,ipv6,mpls
CLICKHOUSE_FLOW_IP_REF_EXTENSIONS=scireg

# FlowStitchingProcessor -- off by default. Set to true to combine flow-cache export
# slices of the same flow into a single stitched record once it goes idle or exceeds
# max duration (like Logstash's aggregate filter), written to a separate table.
CLICKHOUSE_FLOW_STITCH_ENABLED=false
CLICKHOUSE_FLOW_STITCH_TABLE=data_flow_stitched
CLICKHOUSE_FLOW_STITCH_TTL=5 YEAR
CLICKHOUSE_FLOW_STITCH_TTL_COLUMN=start_time
CLICKHOUSE_FLOW_STITCH_PARTITION_BY=toYYYYMMDD(start_time)
CLICKHOUSE_FLOW_STITCH_INACTIVITY_TIMEOUT=630
CLICKHOUSE_FLOW_STITCH_MAX_TIMEOUT=86400
CLICKHOUSE_FLOW_STITCH_SWEEP_INTERVAL=30
CLICKHOUSE_FLOW_STITCH_MIN_BYTES=0
CLICKHOUSE_FLOW_STITCH_MIN_DURATION=0.1
CLICKHOUSE_FLOW_STITCH_ANONYMIZE=yes
CLICKHOUSE_FLOW_STITCH_IPV4_PREFIX=117
CLICKHOUSE_FLOW_STITCH_IPV6_PREFIX=48
