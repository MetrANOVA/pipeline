PIPELINE_YAML=/app/pipelines/metadata_community.yml
CLICKHOUSE_CACHER_TABLES=${CLICKHOUSE_COMMUNITY_METADATA_TABLE},${CLICKHOUSE_AS_METADATA_TABLE}
CLICKHOUSE_METADATA_FORCE_UPDATE=false # Set to true to force updates even if no changes detected
HTTP_CONSUMER_ENV_PREFIX=COMMUNITY
COMMUNITY_HTTP_CONSUMER_UPDATE_INTERVAL=3600
COMMUNITY_HTTP_CONSUMER_URLS="https://downloads.netsage.io/communities.json"
