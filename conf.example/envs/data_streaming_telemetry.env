PIPELINE_YAML=/app/pipelines/data_telegraf.yml
KAFKA_TOPIC=metranova_streaming_telemetry
TELEGRAF_RESOURCE_TYPE=streaming_telemetry
DEVICE_CACHER_TABLE=${CLICKHOUSE_DEVICE_METADATA_TABLE}
# Use the line below instead if collectors are sending hostnames rather than device IDs:
# DEVICE_CACHER_TABLE=${CLICKHOUSE_DEVICE_METADATA_TABLE}:hostname
CLICKHOUSE_CACHER_TABLES=${DEVICE_CACHER_TABLE}